file(READ "${CPD_INPUT}" input)
string(JSON group_count LENGTH "${input}")
set(output "[]")
if(group_count GREATER 0)
    math(EXPR group_last "${group_count} - 1")
    foreach(group RANGE 0 ${group_last})
        string(JSON fragment_count LENGTH "${input}" ${group})
        set(tokens_json "[]")
        set(token_index 0)
        if(fragment_count GREATER 0)
            math(EXPR fragment_last "${fragment_count} - 1")
            foreach(fragment_index RANGE 0 ${fragment_last})
                string(JSON fragment GET "${input}" ${group} ${fragment_index})
                separate_arguments(tokens WINDOWS_COMMAND "${fragment}")
                foreach(token IN LISTS tokens)
                    string(REPLACE "\\" "\\\\" encoded "${token}")
                    string(REPLACE "\"" "\\\"" encoded "${encoded}")
                    string(REPLACE "\n" "\\n" encoded "${encoded}")
                    string(REPLACE "\r" "\\r" encoded "${encoded}")
                    string(REPLACE "\t" "\\t" encoded "${encoded}")
                    string(JSON tokens_json SET "${tokens_json}" ${token_index} "\"${encoded}\"")
                    math(EXPR token_index "${token_index} + 1")
                endforeach()
            endforeach()
        endif()
        string(JSON output SET "${output}" ${group} "${tokens_json}")
    endforeach()
endif()
file(WRITE "${CPD_OUTPUT}" "${output}\n")
