# Run after the host has declared its targets. CMAKE_PROJECT_INCLUDE also runs
# for subprojects, so register this only in the top-level source directory.
if(CMAKE_CURRENT_SOURCE_DIR STREQUAL CMAKE_SOURCE_DIR)
    function(cpd_configure_visual_studio)
        get_property(_cpd_targets DIRECTORY "${CMAKE_SOURCE_DIR}" PROPERTY BUILDSYSTEM_TARGETS)
        set(_cpd_host_target "")
        foreach(_cpd_target IN LISTS _cpd_targets)
            get_target_property(_cpd_type "${_cpd_target}" TYPE)
            if(_cpd_type STREQUAL "EXECUTABLE")
                if(_cpd_host_target)
                    message(FATAL_ERROR "Plugin development requires one top-level game executable; found ${_cpd_host_target} and ${_cpd_target}.")
                endif()
                set(_cpd_host_target "${_cpd_target}")
            endif()
        endforeach()
        if(NOT _cpd_host_target)
            message(FATAL_ERROR "Plugin development could not find the top-level game executable.")
        endif()
        set_property(DIRECTORY "${CMAKE_SOURCE_DIR}" PROPERTY VS_STARTUP_PROJECT "${_cpd_host_target}")
        set_property(TARGET "${_cpd_host_target}" PROPERTY VS_DEBUGGER_WORKING_DIRECTORY "$<TARGET_FILE_DIR:${_cpd_host_target}>")
    endfunction()
    cmake_language(DEFER CALL cpd_configure_visual_studio)
endif()
