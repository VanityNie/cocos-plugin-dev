include_guard(GLOBAL)

set_property(GLOBAL PROPERTY CPD_BINARY_ENGINE "${ENGINE_NAME}")
set_property(GLOBAL PROPERTY CPD_BINARY_PLUGINS "${CC_REGISTERED_PLUGINS}")
set_property(GLOBAL PROPERTY CPD_BINARY_SOURCE "${CMAKE_CURRENT_LIST_DIR}/binary-probe.cpp")

function(cpd_binary_directory_targets binary_source_directory binary_output)
    get_property(binary_targets DIRECTORY "${binary_source_directory}" PROPERTY BUILDSYSTEM_TARGETS)
    get_property(binary_subdirectories DIRECTORY "${binary_source_directory}" PROPERTY SUBDIRECTORIES)
    foreach(binary_subdirectory IN LISTS binary_subdirectories)
        cpd_binary_directory_targets("${binary_subdirectory}" binary_children)
        list(APPEND binary_targets ${binary_children})
    endforeach()
    set(${binary_output} "${binary_targets}" PARENT_SCOPE)
endfunction()

function(cpd_binary_pdb_metadata binary_target binary_engine)
    if(binary_target STREQUAL binary_engine)
        return()
    endif()
    get_target_property(binary_source_dir ${binary_target} SOURCE_DIR)
    if(COCOS_X_PATH)
        cmake_path(IS_PREFIX COCOS_X_PATH "${binary_source_dir}" NORMALIZE binary_engine_source)
        if(binary_engine_source)
            return()
        endif()
    endif()
    get_target_property(binary_target_dir ${binary_target} BINARY_DIR)
    get_target_property(binary_pdb_name ${binary_target} COMPILE_PDB_NAME)
    get_target_property(binary_pdb_directory ${binary_target} COMPILE_PDB_OUTPUT_DIRECTORY)
    if(NOT binary_pdb_name)
        set(binary_pdb_name "${binary_target}")
        set_property(TARGET ${binary_target} PROPERTY COMPILE_PDB_NAME "${binary_pdb_name}")
    endif()
    if(NOT binary_pdb_directory)
        set(binary_pdb_directory "${binary_target_dir}/.plugin-dev/compiler-pdb/$<CONFIG>")
        set_property(TARGET ${binary_target} PROPERTY COMPILE_PDB_OUTPUT_DIRECTORY "${binary_pdb_directory}")
    endif()
    if(CMAKE_CONFIGURATION_TYPES)
        set(binary_configurations ${CMAKE_CONFIGURATION_TYPES})
    else()
        set(binary_configurations ${CMAKE_BUILD_TYPE})
    endif()
    foreach(binary_configuration IN LISTS binary_configurations)
        string(TOUPPER "${binary_configuration}" binary_config_upper)
        get_target_property(binary_config_name ${binary_target} "COMPILE_PDB_NAME_${binary_config_upper}")
        get_target_property(binary_config_directory ${binary_target} "COMPILE_PDB_OUTPUT_DIRECTORY_${binary_config_upper}")
        if(NOT binary_config_name)
            set(binary_config_name "${binary_pdb_name}")
        endif()
        if(NOT binary_config_directory)
            set(binary_config_directory "${binary_pdb_directory}")
            if(CMAKE_CONFIGURATION_TYPES AND NOT binary_config_directory MATCHES "\\$<")
                string(APPEND binary_config_directory "/${binary_configuration}")
            endif()
        endif()
        file(GENERATE OUTPUT "${CMAKE_BINARY_DIR}/.plugin-dev/binary-metadata/${binary_configuration}/compiled-${binary_target}.json"
            CONTENT "{\"target\":\"${binary_target}\",\"artifact\":\"$<TARGET_FILE:${binary_target}>\",\"compilePdb\":\"$<PATH:CMAKE_PATH,$<TARGET_GENEX_EVAL:${binary_target},${binary_config_directory}/${binary_config_name}.pdb>>\"}\n"
            CONDITION "$<CONFIG:${binary_configuration}>")
    endforeach()
endfunction()

function(cpd_generate_binary_metadata)
    get_property(binary_engine GLOBAL PROPERTY CPD_BINARY_ENGINE)
    get_property(binary_plugins GLOBAL PROPERTY CPD_BINARY_PLUGINS)
    get_property(binary_source GLOBAL PROPERTY CPD_BINARY_SOURCE)
    if(NOT TARGET ${binary_engine})
        return()
    endif()
    # CMake 负责解析完整链接关系；这些 target 不参与普通构建。
    add_library(cpd_binary_engine_probe MODULE EXCLUDE_FROM_ALL "${binary_source}")
    target_link_libraries(cpd_binary_engine_probe PRIVATE ${binary_engine})
    set(binary_directory "${CMAKE_BINARY_DIR}/.plugin-dev/binary-metadata/$<CONFIG>")
    if(MSVC)
        cpd_binary_directory_targets("${CMAKE_SOURCE_DIR}" binary_all_targets)
        foreach(binary_static_target IN LISTS binary_all_targets)
            get_target_property(binary_static_type ${binary_static_target} TYPE)
            if(binary_static_type STREQUAL "STATIC_LIBRARY")
                cpd_binary_pdb_metadata(${binary_static_target} ${binary_engine})
            endif()
        endforeach()
    endif()
    set(binary_architecture "${CMAKE_CXX_COMPILER_ARCHITECTURE_ID}")
    if(ANDROID AND NOT binary_architecture)
        if(ANDROID_ABI)
            set(binary_architecture "${ANDROID_ABI}")
        else()
            set(binary_architecture "${CMAKE_ANDROID_ARCH_ABI}")
        endif()
    endif()
    if(ANDROID)
        file(TO_CMAKE_PATH "${CMAKE_C_IMPLICIT_LINK_DIRECTORIES};${CMAKE_CXX_IMPLICIT_LINK_DIRECTORIES}" binary_library_directories)
        file(TO_CMAKE_PATH "${CMAKE_SYSROOT};${CMAKE_ANDROID_NDK};${ANDROID_NDK}" binary_system_directories)
        set(binary_baseline_runtime_dlls "")
    else()
        file(TO_CMAKE_PATH "$ENV{LIB}" binary_library_directories)
        file(TO_CMAKE_PATH "$ENV{VCToolsInstallDir};$ENV{WindowsSdkDir}" binary_system_directories)
        set(binary_baseline_runtime_dlls "\"$<JOIN:$<TARGET_RUNTIME_DLLS:cpd_binary_engine_probe>,\",\">\"")
    endif()
    string(REPLACE ";" "\",\"" binary_library_directories "${binary_library_directories}")
    string(REPLACE ";" "\",\"" binary_system_directories "${binary_system_directories}")
    file(GENERATE OUTPUT "${binary_directory}/toolchain.json" CONTENT
        "{\"schemaVersion\":1,\"configuration\":\"$<CONFIG>\",\"compilerId\":\"${CMAKE_CXX_COMPILER_ID}\",\"compilerVersion\":\"${CMAKE_CXX_COMPILER_VERSION}\",\"frontendVariant\":\"${CMAKE_CXX_COMPILER_FRONTEND_VARIANT}\",\"msvcToolset\":\"${MSVC_TOOLSET_VERSION}\",\"architecture\":\"${binary_architecture}\",\"pointerSize\":${CMAKE_SIZEOF_VOID_P},\"systemName\":\"${CMAKE_SYSTEM_NAME}\",\"androidAbi\":\"${ANDROID_ABI}\",\"androidPlatform\":\"${ANDROID_PLATFORM}\",\"androidStl\":\"${ANDROID_STL}\",\"ndkVersion\":\"${CMAKE_ANDROID_NDK_VERSION}\",\"engineTarget\":\"${binary_engine}\",\"baselineProbe\":\"cpd_binary_engine_probe\",\"libraryDirectories\":[\"${binary_library_directories}\"],\"systemDirectories\":[\"${binary_system_directories}\"],\"runtimeDlls\":[${binary_baseline_runtime_dlls}]}\n")
    foreach(binary_target IN LISTS binary_plugins)
        get_target_property(binary_type ${binary_target} TYPE)
        get_target_property(binary_imported ${binary_target} IMPORTED)
        if(binary_imported)
            set(binary_imported_json "true")
        else()
            set(binary_imported_json "false")
        endif()
        if(NOT binary_type STREQUAL "STATIC_LIBRARY" OR binary_imported)
            file(GENERATE OUTPUT "${binary_directory}/${binary_target}.json" CONTENT
                "{\"schemaVersion\":1,\"target\":\"${binary_target}\",\"imported\":${binary_imported_json},\"error\":\"二进制发布要求由源码构建的 STATIC_LIBRARY target\"}\n")
            continue()
        endif()
        set(binary_probe "${binary_target}_binary_probe")
        add_library(${binary_probe} MODULE EXCLUDE_FROM_ALL "${binary_source}")
        target_link_libraries(${binary_probe} PRIVATE ${binary_target})
        get_target_property(binary_target_link_dirs ${binary_target} LINK_DIRECTORIES)
        if(binary_target_link_dirs)
            target_link_directories(${binary_probe} PRIVATE ${binary_target_link_dirs})
        endif()
        if(ANDROID)
            set(binary_target_runtime_dlls "")
        else()
            set(binary_target_runtime_dlls "\"$<JOIN:$<TARGET_RUNTIME_DLLS:${binary_probe}>,\",\">\"")
        endif()
        file(GENERATE OUTPUT "${binary_directory}/${binary_target}.json" CONTENT
            "{\"schemaVersion\":1,\"target\":\"${binary_target}\",\"probe\":\"${binary_probe}\",\"artifact\":\"$<TARGET_FILE:${binary_target}>\",\"configuration\":\"$<CONFIG>\",\"runtimeDlls\":[${binary_target_runtime_dlls}]}\n")
    endforeach()
endfunction()

cmake_language(DEFER CALL cpd_generate_binary_metadata)
