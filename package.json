{
  "name": "cocos-plugin-dev",
  "version": "0.2.0",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/VanityNie/cocos-plugin-dev.git"
  },
  "homepage": "https://github.com/VanityNie/cocos-plugin-dev#readme",
  "bugs": "https://github.com/VanityNie/cocos-plugin-dev/issues",
  "package_version": 2,
  "description": "Windows 原生插件开发工作台：创建独立 TS + C++ 插件，为游戏宿主添加开发引用并联合调试。",
  "author": "Cocos Plugin Development",
  "main": "./main.js",
  "scripts": {
    "test": "node run-tests.cjs",
    "plugin": "node cli.cjs"
  },
  "engines": { "node": ">=18" },
  "dependencies": { "typescript": "5.9.3", "yazl": "3.3.1" },
  "devDependencies": { "jsdom": "26.1.0" },
  "panels": {
    "default": {
      "title": "插件开发 · Windows",
      "type": "dockable",
      "main": "./panels/default",
      "size": { "min-width": 540, "min-height": 480, "width": 940, "height": 780 }
    }
  },
  "contributions": {
    "menu": [{ "path": "i18n:menu.develop", "label": "插件开发", "message": "open-panel" }],
    "messages": {
      "open-panel": { "methods": ["openPanel"] },
      "get-context": { "methods": ["getContext"] },
      "select-host": { "methods": ["selectHost"] },
      "choose-directory": { "methods": ["chooseDirectory"] },
      "save-settings": { "methods": ["saveSettings"] },
      "start-task": { "methods": ["startTask"] },
      "get-task": { "methods": ["getTask"] },
      "cancel-task": { "methods": ["cancelTask"] },
      "open-source": { "methods": ["openSource"] }
    }
  }
}
