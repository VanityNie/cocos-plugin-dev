{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "strict": true,
    "experimentalDecorators": true,
    "useDefineForClassFields": false,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noEmit": true,
    "paths": {
      "cc": ["./.local/cc-default.d.ts"]
    },
    "plugins": [{ "name": "cocos-plugin-dev-types" }]
  },
  "include": [
    "runtime/**/*.ts",
    "runtime/**/*.d.ts"
  ]
}
